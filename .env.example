# OpenAI-compatible chat API. Leave LLM_API_KEY empty to run the sample library.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional. Search embeddable videos at most 3 minutes long.
# Without it, the feed skips live video search and uses sample clips in demo mode.
YOUTUBE_API_KEY=

# Optional. When set, the app asks for this passcode and stores an httpOnly session cookie.
APP_PASSCODE=

# Cost guards for live generation. Ignored while LLM_API_KEY is empty.
GENERATION_DAILY_CAP=40
RATE_LIMIT_PER_MINUTE=8

# Optional image generation. Off unless exactly "true".
ENABLE_AI_IMAGES=false
LLM_IMAGE_MODEL=dall-e-3
