# Optional. When set, the app asks for this passcode and stores an httpOnly session cookie.
# The human feed and refill signal stay behind it. Leave empty on your own machine.
APP_PASSCODE=

# Secret Grok Bot sends as Authorization: Bearer on ingest and status.
# Leave empty for local demo. The seed bank still serves. Ingest stays closed.
CONTENT_BOT_TOKEN=

# Ask for a refill when the unread queue on this device drops below this count. Default 20.
REFILL_UNREAD_THRESHOLD=20

# Optional. Server-side YouTube Data API search for embeddable clips of at most 3 minutes.
# Leave empty to skip search and use only video cards already in the bank (seed or Grok Bot ingest).
YOUTUBE_API_KEY=

# Durable store for Vercel. Connect Upstash Redis (Vercel KV / Redis integration, free tier).
# Without these, Primer reads and writes data/content.json, which is the local/demo seed.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are accepted as aliases.

# Optional override for the JSON file. Defaults to data/content.json.
# CONTENT_DATA_PATH=
